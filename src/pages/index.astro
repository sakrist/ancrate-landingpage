---
import Layout from '../layouts/Layout.astro';
import Capture from '../components/Capture.astro';
import { app } from '../config';
---
<Layout title="Ancrate — To-dos from Apple Notes" description="Ancrate collects checklists from Apple Notes into one view on your Mac. Search your tasks, filter your notes, and keep a small task panel nearby.">
  <div class="landing wrap">
    <section class="intro" aria-labelledby="intro-title">
      <h1 id="intro-title">To-dos from Apple Notes.</h1>
      <p class="intro-copy">Ancrate collects the checklists in your notes into one view. Search your tasks, open the original note, or keep a small task panel beside your work.</p>
      <p id="availability" class="release-note">
        {app.downloadUrl ? <a class="button primary" href={app.downloadUrl}>Get Ancrate</a> : <span>Coming soon</span>}
        <span class="requirement">For macOS 14 or later.</span>
      </p>
    </section>

    <figure class="app-preview">
      <Capture src="/images/all-todos.png" alt="Ancrate showing checklists from several Apple Notes, with search, completed-task filters, and links to each source note." eager />
      <figcaption>All to-dos, shown with sample notes.</figcaption>
    </figure>

    <section id="features" class="features" aria-labelledby="features-title">
      <h2 id="features-title">What it does</h2>
      <dl>
        <div><dt>Collected checklists</dt><dd>See all your to-dos or focus on notes from the past month or three months. Choose which folders and notes to include. Check tasks off in Apple Notes; Ancrate picks up the changes.</dd></div>
        <div><dt>A menu bar panel</dt><dd>Search by task, note, or folder. Pin the compact panel beside your work and open a task’s original note with a click.</dd></div>
        <div><dt>Slash commands</dt><dd>Type <kbd>/</kbd> in Apple Notes to insert a heading, checklist, quote, or table, or open your collected tasks. Optional; requires Accessibility permission.</dd></div>
        <div><dt>Desktop widgets</dt><dd>See your to-dos in small, medium, or large widgets. Keep Ancrate running to update their local snapshot.</dd></div>
      </dl>
      <p class="local-note">Your notes are read locally on your Mac. No Ancrate account or built-in analytics. Optional read-only MCP access is available for AI clients; <a href="/privacy/">see the privacy details</a>.</p>
      <p class="guide-link"><a href="/support/">Setup and feature guide →</a></p>
    </section>

    <details class="preview-video">
      <summary>Watch the 30-second preview</summary>
      <video controls playsinline preload="none" poster="/social.png" width="1920" height="1080" aria-label="Ancrate preview with sample app captures and instrumental music">
        <source src="/images/ancrate-preview.mp4" type="video/mp4" />
        Your browser cannot play this video. <a href="/images/ancrate-preview.mp4">Download the preview.</a>
      </video>
    </details>
    <p class="contact-note">Questions about Ancrate? <a href={`mailto:${app.supportEmail}`}>Get in touch.</a></p>
  </div>
</Layout>

<style>
  .landing { max-width: 960px; padding: 58px 0 64px; }
  .intro { max-width: 700px; }
  h1 { font-size: clamp(36px, 4.6vw, 56px); line-height: 1.12; letter-spacing: -2px; font-weight: 600; margin: 0 0 22px; }
  .intro-copy { max-width: 650px; color: var(--muted); font-size: 18px; line-height: 1.65; }
  .release-note { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; margin-top: 24px; font-size: 14px; }
  .release-note > span:first-child { font-weight: 600; }
  .requirement { color: var(--muted); }
  .app-preview { margin: 42px 0 60px; }
  .app-preview :global(.capture) { box-shadow: 0 4px 18px #292b270a; }
  figcaption { color: var(--muted); font-size: 12px; margin-top: 12px; }
  h2 { font-size: 25px; font-weight: 600; letter-spacing: -.5px; line-height: 1.3; }
  dl { margin: 24px 0 0; }
  dl > div { display: grid; grid-template-columns: 210px 1fr; gap: 30px; border-top: 1px solid var(--line); padding: 22px 0; }
  dt, dd { font-size: 15px; line-height: 1.75; }
  dt { font-weight: 600; }
  dd { margin: 0; color: var(--muted); }
  .local-note { margin-top: 20px; max-width: 740px; font-size: 14px; color: var(--muted); line-height: 1.8; }
  .guide-link { margin-top: 20px; font-size: 14px; }
  .preview-video { margin-top: 40px; border-block: 1px solid var(--line); }
  summary { padding: 20px 0; cursor: pointer; font-size: 14px; font-weight: 550; }
  video { display: block; width: 100%; height: auto; border-radius: 8px; margin-bottom: 20px; background: #f3f4f5; }
  .contact-note { margin-top: 30px; font-size: 14px; color: var(--muted); }
  @media (max-width: 600px) {
    .landing { padding: 34px 0 44px; }
    h1 { letter-spacing: -1.3px; }
    .intro-copy { font-size: 16px; }
    .app-preview { margin: 30px 0 40px; }
    dl > div { grid-template-columns: 1fr; gap: 7px; padding: 18px 0; }
    .release-note { font-size: 13px; gap: 12px; }
  }
</style>
